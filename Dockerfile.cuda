# Runtime image — NVIDIA CUDA 12.8 (Ubuntu 24.04).
#
# Default: install the released .deb from the GitHub releases page. The
# package's hard deps come along automatically. CUDA toolkit + nvcc come
# from the base image.
#
# To test the local working tree (what setup.sh --from-source does in
# container mode): build the binary and pass it as LOCAL_BINARY. The released
# package is still installed for its dependencies; only the program is yours.
#   CGO_ENABLED=0 go build -o dist/llama-toolchest-local ./cmd/llama-toolchest
#   docker build --build-arg LOCAL_BINARY=dist/llama-toolchest-local \
#                -f Dockerfile.cuda .
#
# To install a locally-built snapshot package instead (dev iteration):
#   make package-snapshot
#   docker build --build-arg INSTALL_PACKAGE=dist/llama-toolchest_<ver>_linux_amd64.deb \
#                -f Dockerfile.cuda .
#
# To pin a specific release version (avoid hitting the GH API at build time):
#   docker build --build-arg LLAMA_TOOLCHEST_VERSION=1.0.0 -f Dockerfile.cuda .

FROM docker.io/nvidia/cuda:12.8.1-devel-ubuntu24.04

# Image revision. Raise this number in a release whose image must be rebuilt
# from scratch: a new system package, a new base image, a new exposed port —
# anything that installing the new release package alone does not bring.
# `./setup.sh quick` compares the number in the latest release's Dockerfile with
# the one on the running image, and offers a full rebuild when the image is
# older. It sits right after FROM so that raising it also makes every later
# step build again, even from cache.
LABEL io.github.tmac1973.llama-toolchest.image-revision="1"

ARG INSTALL_PACKAGE=""
ARG LLAMA_TOOLCHEST_VERSION="latest"
ARG TARGETARCH=amd64

# curl + ca-certificates for the package download; libssl-dev for OpenSSL-
# enabled llama.cpp builds. Build toolchain comes via the .deb's Depends.
#
# libnccl-dev wires up llama.cpp's optimized AllReduce path for tensor
# parallelism (-sm tensor) — without it GGML_CUDA_NCCL still defaults ON
# but the build silently falls back to a slower shfl_tensor_async path.
# The CUDA devel base ships the runtime (libnccl2) but not the headers,
# and the configured NVIDIA repo carries a newer cuda13.x NCCL that
# refuses to co-install with the base's cuda12.x libnccl2. Pin the dev
# headers to whatever libnccl2 is already on disk so the versions match.
RUN --mount=type=cache,target=/var/cache/apt,sharing=locked \
    --mount=type=cache,target=/var/lib/apt,sharing=locked \
    set -e; \
    apt-get update; \
    apt-get install -y --no-install-recommends curl ca-certificates libssl-dev; \
    if ! dpkg -s libnccl-dev >/dev/null 2>&1; then \
        NCCL_VER="$(dpkg-query -W -f='${Version}' libnccl2 2>/dev/null || true)"; \
        if [ -n "$NCCL_VER" ]; then \
            apt-get install -y --no-install-recommends "libnccl-dev=${NCCL_VER}"; \
        else \
            apt-get install -y --no-install-recommends libnccl-dev; \
        fi; \
    fi

# uv is required by the llama-benchy benchmark integration — the
# benchmark runner shells out to `uvx llama-benchy`. Install
# system-wide so the llama-toolchest service finds it on $PATH.
RUN curl -LsSf https://astral.sh/uv/install.sh \
    | env UV_INSTALL_DIR=/usr/local/bin INSTALLER_NO_MODIFY_PATH=1 sh

# Node.js and pnpm build the built-in web UI of stable-diffusion.cpp's
# sd-server (a build option on the Builds page). The web UI needs Node 20 or
# newer, and Ubuntu 24.04 only has 18, so Node comes from nodejs.org, checked
# against the release's published SHA-256 list. Both versions are pinned so
# every image builds the web UI the same way.
ARG NODE_VERSION=22.23.3
RUN set -eux; \
    case "${TARGETARCH}" in amd64) node_arch=x64 ;; arm64) node_arch=arm64 ;; *) echo "no Node.js build for ${TARGETARCH}"; exit 1 ;; esac; \
    tarball="node-v${NODE_VERSION}-linux-${node_arch}.tar.gz"; \
    cd /tmp; \
    curl -fsSLO "https://nodejs.org/dist/v${NODE_VERSION}/${tarball}"; \
    curl -fsSL "https://nodejs.org/dist/v${NODE_VERSION}/SHASUMS256.txt" | grep " ${tarball}\$" | sha256sum -c -; \
    tar -xzf "${tarball}" -C /usr/local --strip-components=1 --no-same-owner; \
    rm -f "${tarball}"; \
    npm install -g pnpm@9.15.4; \
    node --version; pnpm --version

# apt-get update runs again here, not only in the earlier step: this step mounts
# the whole build context, so it runs again after any change to the checkout,
# while the earlier one usually stays cached. Its package lists can then be weeks
# old, and apt asks for package versions Ubuntu has since removed (a 404).
RUN --mount=type=bind,target=/build_context \
    --mount=type=cache,target=/var/cache/apt,sharing=locked \
    --mount=type=cache,target=/var/lib/apt,sharing=locked \
    set -e; \
    apt-get update; \
    if [ -n "${INSTALL_PACKAGE}" ]; then \
        echo "Installing local snapshot: /build_context/${INSTALL_PACKAGE}"; \
        apt-get install -y --no-install-recommends "/build_context/${INSTALL_PACKAGE}"; \
    else \
        if [ "${LLAMA_TOOLCHEST_VERSION}" = "latest" ]; then \
            VERSION=$(curl -fsSL https://api.github.com/repos/tmac1973/llama-toolchest/releases/latest \
                | grep -m1 '"tag_name"' | sed 's/.*"v\?\([^"]*\)".*/\1/'); \
        else \
            VERSION="${LLAMA_TOOLCHEST_VERSION}"; \
        fi; \
        echo "Installing release v${VERSION} (linux/${TARGETARCH})"; \
        curl -fsSL -o /tmp/llama-toolchest.deb \
            "https://github.com/tmac1973/llama-toolchest/releases/download/v${VERSION}/llama-toolchest_${VERSION}_linux_${TARGETARCH}.deb"; \
        apt-get install -y --no-install-recommends /tmp/llama-toolchest.deb; \
        rm /tmp/llama-toolchest.deb; \
    fi

# Development override: replace the packaged binary with one built from the
# local tree. setup.sh --from-source in container mode sets this; it is empty
# for a normal build, and then this step does nothing.
#
# The package above is still installed in full, which is the point — it brings
# the dependencies (cmake, ninja, git, the compiler) and the systemd units, so
# only the program itself differs from a release. The binary is built
# CGO_ENABLED=0 and the web templates and static files are compiled into it via
# go:embed, so copying this one file replaces both the code and the UI.
ARG LOCAL_BINARY=""
RUN --mount=type=bind,target=/build_context \
    set -e; \
    if [ -n "${LOCAL_BINARY}" ]; then \
        echo "Replacing packaged binary with local build: ${LOCAL_BINARY}"; \
        install -m 0755 "/build_context/${LOCAL_BINARY}" /usr/bin/llama-toolchest; \
        llama-toolchest --version; \
    fi

RUN mkdir -p /data/config /data/builds /data/models

RUN cat > /data/config/llama-toolchest.yaml <<'EOF'
listen_addr: ":3000"
data_dir: "/data"
llama_port: 8080
log_level: "info"
gen_port_start: 8081
gen_port_count: 8
EOF

VOLUME ["/data"]

# llama-toolchest web UI
EXPOSE 3000
# llama-server instances (chat UI + inference)
EXPOSE 8080
# image and music generation backends, one port each (their own web UIs)
EXPOSE 8081-8088

ENTRYPOINT ["llama-toolchest", "--config", "/data/config/llama-toolchest.yaml"]
