# version: 0.0.0
# llama-toolchest video upscale script for RelayVSR. Based on
# stable-diffusion.cpp docs/dgl/relay_vsr/relayvsr-x2-video-upscale.dgl
# (blob c678a13, the same in master-1116 and master-1122). Toolchest fills
# in the var block, loads the clip at its own frame rate, saves webm or avi,
# and returns only the result's shape.

var {
    dit_path = "/models/gen-models/relayvsr/dit.safetensors"
    vae_path = "/models/gen-models/relayvsr/vae.safetensors"

    input_path = "input/job1.webm"
    output_path = "output/job1.webm"

    seed = 42
    window_size = 16

    sampler = "euler"
}

fn keyframe_indices(frames, stride) {
    count = tensor::shape(frames)[3]
    last = count - 1
    regular = tensor::arange(0, last, step = stride)
    return tensor::concat([regular, tensor::vector([last], dtype = "i64")], axis = 0)
}

fn upscale_window(frames, dit, flash, rng, window_size, sampler) {
    indices = keyframe_indices(frames, stride = window_size - 1)
    keyframes = tensor::index_select(frames, axis = 3, indices = indices)
    positive = { crossattn = relayvsr::positive_embedding(dit), lq_frames = keyframes }
    base = tensor::zeros(relayvsr::latent_shape(dit, keyframes))
    noise = tensor::randn_like(base, rng = rng)
    sigmas = tensor::vector([1.0, 0.0])
    positive_predictor = predictor(dit, positive)
    latent = sample(noise, sigmas, predict = positive_predictor, method = sampler, rng = rng)
    return relayvsr::decode(flash, latent, frames, keyframe_indices = indices)
}

fn main() {
    dit = load_dit(dit_path)
    flash = load_vae(vae_path)
    clip = video::load(input_path)
    frames = clip.video.frames
    rng = make_rng("cuda", seed = seed)
    windows = video::split_windows(frames, size = window_size, overlap = 1)
    enhanced = map(windows, process = upscale_window, dit = dit, flash = flash, rng = rng, window_size = window_size, sampler = sampler)
    pixels = video::join_windows(enhanced, overlap = 1)
    media::save(output_path, video::encode({frames = pixels, fps_num = clip.video.fps_num, fps_den = clip.video.fps_den}, format = "webm"))
    shape = tensor::shape(pixels)
    return { width = shape[1], height = shape[2], frames = shape[3] }
}
